                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/delivery-boy",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "delivery-boy"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "auth_token",
      "value": "PASTE_YOUR_JWT_TOKEN_HERE"
